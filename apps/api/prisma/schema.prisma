// Prisma schema for Dhruva.
//
// Design notes:
// - `Job.embedding_status` lets the AI service track which postings still need
//   embeddings without round-tripping through a join table.
// - `Job` has a unique constraint on (source, externalId) so re-ingesting from
//   a source is idempotent — UPSERT does the right thing.
// - `JobScore` is denormalized per (user, cv, job) so we can recompute scores
//   when the user uploads a new CV without recomputing for old CVs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleSub String   @unique @map("google_sub")
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cvs           Cv[]
  scores        JobScore[]
  refreshTokens RefreshToken[]
  chatSessions  ChatSession[]

  @@map("users")
}

// Server-side records for opaque refresh tokens. We never store the raw secret
// — only a SHA-256 hash — so a DB leak doesn't hand attackers live sessions.
//
// On every successful refresh we rotate: the presented token is marked revoked,
// a fresh one is issued, and `replacedById` links them. If a token that's
// already revoked is ever presented again, that's a theft signal — we revoke
// the entire chain for that user (forces re-login on every device).
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  // SHA-256(hex) of the opaque secret we put in the cookie.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  // Points at the token that superseded this one on rotation. Lets us walk a
  // chain and revoke siblings on reuse detection.
  replacedById String?   @map("replaced_by_id")
  // Light telemetry to help a user diagnose "what device is signed in?" later.
  userAgent    String?   @map("user_agent")
  ip           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Cv {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  // S3 object key, not a full URL — keeps the URL construction in one place.
  objectKey   String   @map("object_key")
  filename    String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  // Plain text extracted from the file. Filled in by a follow-up worker
  // (Phase 2). Nullable on initial insert.
  parsedText  String?  @map("parsed_text") @db.Text
  // Structured CV (skills, experience, etc.) — filled by LLM extraction in Phase 2.
  parsedJson  Json?    @map("parsed_json")
  version     Int      @default(1)
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores JobScore[]

  @@index([userId])
  @@map("cvs")
}

enum EmbeddingStatus {
  pending
  processing
  done
  failed
}

model Job {
  id              String          @id @default(cuid())
  source          String // 'remotive' | 'greenhouse' | 'hn-who-is-hiring' ...
  externalId      String          @map("external_id") // unique within source
  title           String
  company         String
  location        String?
  remote          Boolean         @default(false)
  salaryMin       Int?            @map("salary_min")
  salaryMax       Int?            @map("salary_max")
  currency        String?
  // Raw HTML/markdown from the source (kept for debugging and re-extraction).
  descriptionRaw  String          @map("description_raw") @db.Text
  // Cleaned markdown for display + embedding.
  descriptionMd   String          @map("description_md") @db.Text
  applyUrl        String          @map("apply_url")
  postedAt        DateTime        @map("posted_at")
  ingestedAt      DateTime        @default(now()) @map("ingested_at")
  // Structured fields from LLM extraction (Phase 2).
  extractedJson   Json?           @map("extracted_json")
  // Tracks the embedding lifecycle for the AI service worker (Phase 2).
  embeddingStatus EmbeddingStatus @default(pending) @map("embedding_status")
  embeddedAt      DateTime?       @map("embedded_at")

  scores JobScore[]

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([embeddingStatus])
  @@map("jobs")
}

model JobScore {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  cvId           String   @map("cv_id")
  jobId          String   @map("job_id")
  score          Float
  // Per-section breakdown (skills, experience, etc.) — filled by Phase 2.
  scoreBreakdown Json?    @map("score_breakdown")
  computedAt     DateTime @default(now()) @map("computed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv   Cv   @relation(fields: [cvId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, cvId, jobId])
  @@index([userId, score])
  @@map("job_scores")
}

// ─── Chat (Slice 2.3) ─────────────────────────────────────────────────────
//
// One ChatSession per "conversation thread" in the sidebar.
// One ChatMessage per turn — user message, assistant reply, OR tool call/result.
//
// Observability fields (tokensIn/Out, latencyMs, costUsd, model) are filled on
// every assistant message at write time. Slice 2.4's cost dashboard reads
// straight from this table — no schema change at 2.4 time, that's the point.
//
// citedJobIds: when the agent's reply was grounded by retrieval results
// (search_jobs / get_job_details tool returns), we record the referenced
// job ids so the UI can render provenance chips.

enum ChatRole {
  user
  assistant
  tool
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // Auto-derived from the first user message (truncated). Null until the
  // first turn lands. Editable later via a rename endpoint (Phase 3).
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  role        ChatRole
  // Free-form display text. For role=tool this is the JSON-stringified result
  // for traceability; the UI doesn't render it directly.
  content     String   @db.Text
  // For role=assistant turns that invoke tools: the structured tool_calls
  // returned by the model (id, name, args). Null otherwise.
  toolCalls   Json?    @map("tool_calls")
  // For role=tool messages: which tool's result this carries.
  toolName    String?  @map("tool_name")
  // Job ids the agent grounded its answer with. Empty by default.
  citedJobIds String[] @default([]) @map("cited_job_ids")

  // ─── Observability (Slice 2.4 plugs in here without migration) ───────
  model     String?
  tokensIn  Int?     @map("tokens_in")
  tokensOut Int?     @map("tokens_out")
  latencyMs Int?     @map("latency_ms")
  costUsd   Decimal? @map("cost_usd") @db.Decimal(10, 6)

  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
